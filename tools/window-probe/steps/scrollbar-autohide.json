    {
      "control": {
        "wheel": {
          "x": 620,
          "y": 400,
          "lines": -100
        }
      },
      "wait": 200,
      "capture": "scrolling-shown"
    },
    {
      "control": {
        "wheel": {
          "x": 620,
          "y": 400,
          "lines": -100
        }
      },
      "wait": 2600,
      "capture": "auto-hidden"
    },
    {
      "control": {
        "pointer": {
          "at": [
            1234,
            430
          ],
          "event": "hover"
        }
      },
      "wait": 200,
      "capture": "hover-revealed"
    },
    {
      "wait": 2600,
      "capture": "hover-faded"
    },
    {
      "control": {
        "dialog": "whatsnew"
      },
      "wait": 1200,
      "inspect": "layout",
      "label": "whatsnew-open",
      "expect": {
        "dialog.kind": "whatsnew",
        "dialog.ready": true
      }
    },
    {
      "control": {
        "scrollTrace": 9000
      },
      "wait": 30
    },
    {
      "control": {
        "wheel": {
          "x": 620,
          "y": 550,
          "lines": -5
        }
      },
      "wait": 200,
      "capture": "dialog-shown"
    },
    {
      "wait": 2600,
      "capture": "dialog-hidden"
    },
    {
      "control": {
        "keys": [
          "escape"
        ]
      },
      "wait": 350,
      "inspect": "layout",
      "label": "dialog-closed",
      "expect": {
        "dialog": null
      }
    },
    {
      "note": "The select popup's own bar (select-scrollbar) shows and fades the same way; 640x480 leaves neither side tall enough for all eight options, so the list scrolls."
    },
    {
      "probe": "size 800 600",
      "control": {
        "page": "settings",
        "scrollTrace": 9000
      },
      "wait": 700,
      "note": "App min is 640x480 LOGICAL px; the probe requests PHYSICAL px. At the display scale of this run (dpiScale 1.25, see ui-conditions) 640x480 logical = 800x600 physical. Requesting 640 physical sits below the clamp and never settles."
    },
    {
      "control": {
        "clickAnchor": "settings-language"
      },
      "wait": 300,
      "capture": "select-open"
    },
    {
      "control": {
        "wheel": {
          "x": 320,
          "y": 330,
          "lines": -3
        }
      },
      "wait": 200,
      "capture": "select-scrolled"
    },
    {
      "control": {
        "clickAnchor": "settings-language"
      },
      "wait": 300,
      "inspect": "layout",
      "label": "select-closed",
      "expect": {
        "page": "settings"
      }
    },
    {
      "probe": "size 1240 860",
      "wait": 400,
      "capture": "regression"
    }
