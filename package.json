{
  "name": "goodgood",
  "private": true,
  "version": "0.5.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "app": "node scripts/desktop.mjs dev",
    "build": "node scripts/build.mjs",
    "bundle": "node scripts/build.mjs --installer",
    "site:dev": "bun run --cwd website dev",
    "site:build": "bun run --filter @goodgood/website build",
    "site:check": "bun run --filter @goodgood/website check",
    "check:generated": "node scripts/native-dispatch.mjs --check",
    "lint": "biome check locales resources",
    "format": "biome format --write locales resources",
    "i18n": "node scripts/i18n.mjs",
    "test": "node --test \"scripts/tests/*.test.mjs\" \"scripts/tests/*.test.ts\"",
    "test:startup": "node scripts/test-dev-startup.mjs",
    "check": "bun run lint && bun run i18n && bun run check:generated && bun run test && cargo fmt --all --check && cargo clippy --workspace --all-targets --target-dir target/rust-analyzer -- -D warnings && cargo test --workspace --target-dir target/rust-analyzer",
    "check:security": "bun audit --audit-level low && cargo audit",
    "commitlint": "node scripts/release.mjs lint",
    "release": "node scripts/release.mjs bump"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7"
  },
  "workspaces": ["website"]
}
